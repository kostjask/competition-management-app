# Copy to ignored deploy/staging.env; use independent generated values.
# Hexadecimal avoids URL escaping ambiguity in the Compose database URL.
STAGING_DB_PASSWORD=
STAGING_JWT_SECRET=
STAGING_EMAIL_QUEUE_KEY=
# Local rehearsal: production fake refuses email requests; no external messages.
STAGING_EMAIL_PROVIDER=fake
STAGING_EMAIL_FROM=staging@example.invalid
STAGING_WEB_ORIGIN=https://staging.example.invalid
# After account + DNS setup, choose resend and configure through secret management.
STAGING_RESEND_API_KEY=
