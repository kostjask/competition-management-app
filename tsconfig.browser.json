{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "tests/browser/**/*.ts",
    "apps/web/tests/browser-setup.ts",
    "apps/web/tests/foundation.test.tsx"
  ]
}
