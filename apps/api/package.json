{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.seed.json",
    "test": "node --test tests/*.test.cjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "seed": "prisma db seed --config prisma.config.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0"
  },
  "dependencies": {
    "@dance/schemas": "workspace:*",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  }
}
