# ============================================================================
# ENVIRONMENT VARIABLES REFERENCE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#

# ====================
# Node Environment
# ====================
NODE_ENV=development

# ====================
# Server Configuration
# ====================
PORT=4000
HOST=0.0.0.0

# ====================
# Database (PostgreSQL)
# ====================
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://dance_user:dance_pass@localhost:5432/dance_comp

# ====================
# Authentication
# ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_required
# Positive compact duration: ms, s, m, h, d, w, y (for example 1.5h or 7d)
JWT_EXPIRY=7d

# ====================
# Storage Configuration
# ====================
# Options: local, s3, gcs
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 (required if STORAGE_TYPE=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name

# Google Cloud Storage (required if STORAGE_TYPE=gcs)
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET=your-bucket-name
# GCS_KEY_FILE=/path/to/service-account-key.json

# ====================
# Email Configuration
# ====================
# Options: fake (silent development/test), resend (durable encrypted queue)
EMAIL_PROVIDER=fake
EMAIL_FROM=noreply@dance-competition.com
WEB_ORIGIN=http://localhost:5173
# Real mail requires an HTTPS origin without path/query/fragment, verified sender,
# Resend API key and independent 32-byte hexadecimal queue encryption key.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_QUEUE_KEY=<generate locally; do not share or commit>

# ====================
# Development Options
# ====================
# Skip bearer entry only in NODE_ENV=development; use this real active, verified
# account's database roles. Run the explicit development seed first.
DEV_AUTH=false
DEV_AUTH_EMAIL=admin@test.com

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================
# Security
# ====================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGIN=*

# Rate limiting (per window in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
