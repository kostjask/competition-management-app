# ============================================================================
# ENVIRONMENT VARIABLES REFERENCE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#

# ====================
# Node Environment
# ====================
NODE_ENV=development

# ====================
# Server Configuration
# ====================
PORT=4000
HOST=0.0.0.0

# ====================
# Database (PostgreSQL)
# ====================
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dance_competition

# ====================
# Authentication
# ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_required
JWT_EXPIRY=7d

# ====================
# Storage Configuration
# ====================
# Options: local, s3, gcs
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 (required if STORAGE_TYPE=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name

# Google Cloud Storage (required if STORAGE_TYPE=gcs)
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET=your-bucket-name
# GCS_KEY_FILE=/path/to/service-account-key.json

# ====================
# Email Configuration
# ====================
# Options: smtp, resend, sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@dance-competition.com

# SMTP Configuration (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Resend Configuration (required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# SendGrid Configuration (required if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ====================
# Development Options
# ====================
# Set to 'true' to bypass authentication (DEV ONLY - never use in production!)
DEV_AUTH=false

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================
# Security
# ====================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGIN=*

# Rate limiting (per window in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
