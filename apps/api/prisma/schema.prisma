generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStage {
  PRE_REGISTRATION
  REGISTRATION_OPEN
  DATA_REVIEW
  FINALIZED
  ENDED
  CANCELLED
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  LOCKED
  CANCELLED
}

enum StudioApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RECOVERY
}

enum RecipientLocale {
  et
  en
  ru
}

enum OnboardingStatus {
  DRAFT
  CANCELLED
  COMPLETED
}

model EmailDelivery {
  id             String        @id
  ciphertext     String?
  bindingDigest  String?
  purpose        String?
  state          String        @default("PENDING")
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now())
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  acceptedAt     DateTime?
  providerId     String?
  reviewNoticeId String?
  reviewNotice   ReviewNotice? @relation(fields: [reviewNoticeId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt])
  @@index([reviewNoticeId])
}

model ReviewNotice {
  id             String                  @id @default(uuid())
  registrationId String
  revision       Int
  axis           String
  mode           String
  createdAt      DateTime                @default(now())
  registration   StudioEventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  deliveries     EmailDelivery[]

  @@unique([registrationId, revision, axis])
}

model Event {
  id                      String     @id @default(cuid())
  name                    String
  startsAt                DateTime
  endsAt                  DateTime
  stage                   EventStage @default(PRE_REGISTRATION)
  timeZone                String     @default("UTC")
  registrationDeadline    DateTime?
  createdAt               DateTime   @default(now())
  venue                   String?
  country                 String?
  city                    String?
  description             String?
  descriptionSourceLocale String?
  descriptionTranslations Json       @default("{}")
  organizerEmail          String?
  organizerPhone          String?
  revision                Int        @default(1)
  creationOperationId     String?    @unique
  creationDigest          String?
  maxStudios              Int?
  maxPerformances         Int?
  imageUrl                String?
  imagePath               String?

  ageGroups           AgeGroup[]
  categories          DanceCategory[]
  formats             DanceFormat[]
  judges              Judge[]
  performances        Performance[]
  studios             Studio[]
  userRoles           UserRole[]
  studioRegistrations StudioEventRegistration[]
  invitations         Invitation[]
  onboardingDrafts    OnboardingDraft[]
}

model DanceCategory {
  id      String @id @default(cuid())
  eventId String
  name    String

  event        Event         @relation(fields: [eventId], references: [id])
  performances Performance[]

  @@unique([eventId, name])
  @@unique([id, eventId])
}

model AgeGroup {
  id           String        @id @default(cuid())
  eventId      String
  name         String
  minAge       Int
  maxAge       Int?
  event        Event         @relation(fields: [eventId], references: [id])
  performances Performance[]

  @@unique([id, eventId])
}

model DanceFormat {
  id                 String        @id @default(cuid())
  eventId            String
  name               String
  minParticipants    Int
  maxParticipants    Int
  maxDurationSeconds Int
  event              Event         @relation(fields: [eventId], references: [id])
  performances       Performance[]

  @@unique([id, eventId])
}

model Studio {
  id             String               @id @default(cuid())
  eventId        String
  name           String
  approvalStatus StudioApprovalStatus @default(PENDING)
  approvalReason String?
  country        String?
  city           String?
  directorName   String?
  directorPhone  String?
  invoiceDetails Json?
  logoUrl        String?
  logoPath       String?
  deletedAt      DateTime?
  deletedBy      String?

  dancers         Dancer[]
  event           Event                     @relation(fields: [eventId], references: [id])
  representatives StudioRepresentative[]
  registrations   StudioEventRegistration[]
  invitations     Invitation[]
  performances    Performance[]

  @@unique([id, eventId])
}

model StudioRepresentative {
  id            String   @id @default(cuid())
  studioId      String
  userId        String
  name          String
  email         String
  active        Boolean  @default(true)
  deactivatedBy String?
  createdAt     DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([studioId, userId])
}

model StudioEventRegistration {
  id                  String                  @id @default(cuid())
  studioId            String
  eventId             String
  status              EventRegistrationStatus @default(PENDING)
  canEditDuringReview Boolean                 @default(false)
  revision            Int                     @default(1)
  decisionReason      String?
  operationId         String?                 @unique
  requestDigest       String?
  createdBy           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  studio Studio @relation(fields: [studioId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  reviewNotices ReviewNotice[]
  performances  Performance[]

  @@unique([studioId, eventId])
  @@unique([id, studioId, eventId])
}

model Dancer {
  id                      String                   @id @default(cuid())
  studioId                String
  firstName               String
  lastName                String
  birthDate               DateTime
  photoUrl                String?
  photoPath               String?
  deletedAt               DateTime?
  deletedBy               String?
  studio                  Studio                   @relation(fields: [studioId], references: [id])
  performanceParticipants PerformanceParticipant[]

  @@unique([id, studioId])
}

model Performance {
  id             String    @id @default(cuid())
  eventId        String
  studioId       String
  registrationId String
  categoryId     String
  ageGroupId     String
  formatId       String
  title          String
  durationSec    Int
  orderOnStage   Int
  deletedAt      DateTime?
  deletedBy      String?

  studio       Studio                   @relation(fields: [studioId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  registration StudioEventRegistration  @relation(fields: [registrationId, studioId, eventId], references: [id, studioId, eventId], onDelete: Restrict, onUpdate: Restrict)
  ageGroup     AgeGroup                 @relation(fields: [ageGroupId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  category     DanceCategory            @relation(fields: [categoryId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  event        Event                    @relation(fields: [eventId], references: [id])
  format       DanceFormat              @relation(fields: [formatId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict)
  participants PerformanceParticipant[]
  scores       Score[]

  @@unique([eventId, orderOnStage])
  @@unique([id, studioId])
}

model PerformanceParticipant {
  performanceId String
  dancerId      String
  studioId      String

  dancer      Dancer      @relation(fields: [dancerId, studioId], references: [id, studioId], onDelete: Restrict, onUpdate: Restrict)
  performance Performance @relation(fields: [performanceId, studioId], references: [id, studioId], onDelete: Restrict, onUpdate: Restrict)

  @@id([performanceId, dancerId])
}

model Judge {
  id          String  @id @default(cuid())
  eventId     String
  userId      String
  name        String
  description String?
  country     String?
  city        String?
  event       Event   @relation(fields: [eventId], references: [id])
  user        User    @relation(fields: [userId], references: [id])
  scores      Score[]

  @@unique([userId, eventId])
}

model Score {
  id            String  @id @default(cuid())
  performanceId String
  judgeId       String
  criterion     String
  value         Float
  comment       String?

  judge       Judge       @relation(fields: [judgeId], references: [id])
  performance Performance @relation(fields: [performanceId], references: [id])

  @@unique([performanceId, judgeId, criterion])
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  password       String? // Optional for now (supports OAuth later)
  emailVerified  Boolean  @default(false)
  sessionVersion Int      @default(0)
  // SQL-only User_session_version_nonnegative; reset/correction revoke prior JWT revisions.
  createdAt      DateTime @default(now())
  active         Boolean  @default(true)
  deactivatedBy  String?
  photoUrl       String?
  photoPath      String?

  roles                 UserRole[]
  studioRepresentatives StudioRepresentative[]
  createdInvitations    Invitation[]           @relation("CreatedInvitations")
  judges                Judge[]
  accountTokens         AccountToken[]
  auditActions          AuditLog[]             @relation("AuditActor")
  preferredLocale       RecipientLocale?
  onboardingDraft       OnboardingDraft?
}

model OnboardingDraft {
  id              String           @id @default(uuid())
  userId          String           @unique
  intendedEventId String?
  status          OnboardingStatus @default(DRAFT)
  revision        Int              @default(1)
  operationId     String           @db.Uuid
  details         Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  intendedEvent   Event?           @relation(fields: [intendedEventId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorKind  String
  actorId    String?
  targetType String
  targetId   String
  eventId    String?
  studioId   String?
  metadata   Json
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  // SQL-only immutable trigger and actor-kind check; no public read/write endpoint.

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId])
  @@index([eventId, createdAt])
}

model AccountToken {
  id         String              @id @default(uuid())
  userId     String
  email      String
  purpose    AccountTokenPurpose
  digest     String              @unique
  createdAt  DateTime            @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  // SQL-only AccountToken_outstanding_unique: one unconsumed/unrevoked per purpose.
  // SQL-only CHECKs enforce digest format, positive lifetime and exclusive terminal states.
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]

  @@unique([id, key])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  eventId   String?
  removedAt DateTime?

  user  User   @relation(fields: [userId], references: [id])
  role  Role   @relation(fields: [roleId], references: [id])
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, eventId])
}

model Invitation {
  id           String          @id @default(uuid())
  email        String
  roleKey      String // "judge", "moderator", etc.
  eventId      String?
  tokenDigest  String?         @unique // Null only for invalidated legacy links.
  createdBy    String
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  supersededAt DateTime? // Expired invitation replaced; retained as history.
  revokedAt    DateTime?
  roleId       String? // Unclassified historical invitations cannot be accepted.
  studioId     String?
  locale       RecipientLocale @default(et)

  creator User    @relation("CreatedInvitations", fields: [createdBy], references: [id])
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  role    Role?   @relation(fields: [roleId, roleKey], references: [id, key], onDelete: Restrict)
  studio  Studio? @relation(fields: [studioId, eventId], references: [id, eventId], onDelete: Restrict)

  // SQL-only Invitation_outstanding_unique: null-safe, unused, not superseded.
  // SQL-only CHECKs enforce digest format, invalidated legacy links and superseded revocation.
}
